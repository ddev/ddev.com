Output help-new.mp4
Set Shell bash
Set FontSize 22
Set Width 1200
Set Height 692
Set Padding 24
Set TypingSpeed 100ms
Env PATH "/home/stas/tmp/fakebin:/home/stas/tmp/vhs-tools:/home/stas/tmp/wt-v1255/.gotmp/bin/linux_amd64:/usr/local/bin:/usr/bin:/bin"
Env DDEV_XDG_CONFIG_HOME "/home/stas/tmp/tui-demo-xdg"
Env DDEV_NO_INSTRUMENTATION "true"
Hide
Type "cd ~/tmp/sites && clear"
Enter
Type "ddev"
Enter
Sleep 8s
Down@200ms 4
Sleep 1s
Show
Sleep 2500ms
Type "?"
Sleep 6s
