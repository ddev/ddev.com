Output list-old.mp4
Set Shell bash
Set FontSize 22
Set Width 1200
Set Height 692
Set Padding 24
Set TypingSpeed 100ms
Env PATH "/home/stas/tmp/fakebin:/home/stas/tmp/vhs-tools:/home/stas/tmp/ddev-download-ddev/v1.25.4:/usr/local/bin:/usr/bin:/bin"
Env DDEV_XDG_CONFIG_HOME "/home/stas/tmp/tui-demo-xdg"
Env DDEV_NO_INSTRUMENTATION "true"
Hide
Type "cd ~/tmp/sites && clear"
Enter
Show
Sleep 2s
Type "ddev"
Sleep 1s
Enter
Sleep 5s
Down@800ms 4
Sleep 2500ms
