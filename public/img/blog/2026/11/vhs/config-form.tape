Output config-form.mp4
Set Shell bash
Set FontSize 22
Set Width 1200
Set Height 840
Set Padding 24
Set TypingSpeed 100ms
Env PATH "/home/stas/tmp/fakebin:/home/stas/tmp/wt-v1256/.gotmp/bin/linux_amd64:/usr/local/bin:/usr/bin:/bin"
Env DDEV_XDG_CONFIG_HOME "/home/stas/tmp/release-config-xdg"
Env DDEV_NO_INSTRUMENTATION "true"
Hide
Type "cd ~/tmp/sites/conference-site && clear"
Enter
Show
Sleep 2s
Type "ddev config"
Sleep 1s
Enter
Sleep 5s
Up@600ms 5
Sleep 2s
Enter
Sleep 2s
Up@300ms 7
Sleep 1500ms
Enter
Sleep 3s
Down@600ms 3
Sleep 2s
Enter
Sleep 1500ms
Down@600ms 2
Sleep 1500ms
Enter
Sleep 3s
Down@600ms 3
Sleep 2s
Enter
Sleep 5s
