Output list-old.mp4
Set Shell bash
Set FontSize 22
Set Width 1400
Set Height 1000
Set Padding 24
Set TypingSpeed 100ms
Env PATH "/home/stas/tmp/fakebin:/home/stas/tmp/ddev-download-ddev/v1.25.5:/usr/local/bin:/usr/bin:/bin"
Env DDEV_XDG_CONFIG_HOME "/home/stas/tmp/release-demo-xdg"
Env DDEV_NO_INSTRUMENTATION "true"
Hide
Type "cd ~/tmp/sites && clear"
Enter
Show
Sleep 1s
Type "ddev list"
Sleep 1s
Enter
Sleep 6s
