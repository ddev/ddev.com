---
/**
 * Cards for the three most recent blog posts, shown on the homepage.
 */

import BlogPostCard from "./BlogPostCard.astro"
import { getCollection } from "astro:content"

const posts = await getCollection("blog")
const recentPosts = posts
  .sort((a, b) => {
    return new Date(a.data.pubDate) > new Date(b.data.pubDate) ? -1 : 1
  })
  .slice(0, 3)
---

<div class="relative section">
  <div class="site-container site-gutter relative">
    <div class="text-center">
      <h2 id="blog" class="section-label"><a href="#blog">Blog</a></h2>
      <p class="section-title">
        Latest from the blog.
      </p>
    </div>
    <div class="mt-12 max-w-lg mx-auto grid gap-5 lg:grid-cols-3 lg:max-w-none">
      {recentPosts.map((post) => <BlogPostCard post={post} level={3} />)}
    </div>
  </div>
</div>
