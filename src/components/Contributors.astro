---
import { getContributors } from "../lib/api.js"
import { Image } from 'astro:assets';

import FeaturedSponsors from "./FeaturedSponsors.astro"
import Sponsors from "./Sponsors.astro"

const contributors = await getContributors()
---

<div class="relative section">
  <div class="site-container site-gutter relative">
    <div class="text-center mb-12">
      <h2 id="supporters" class="section-label"><a href="#supporters">Supporters</a></h2>
      <p class="section-title">
        Our wonderful supporters.
      </p>
      <p class="section-lead">
        These organizations and people keep DDEV free and open source.{" "}
        <a href="/sponsor" class="font-medium text-navy-300 underline dark:text-navy-100">Join them</a>.
      </p>
    </div>

    <h3 id="featured-sponsors" class="section-subheading mb-8 text-center">
      <a href="#featured-sponsors">Featured Sponsors</a>
    </h3>
    <div class="max-w-4xl mx-auto flex flex-wrap justify-center">
      <FeaturedSponsors />
    </div>

    <h3 id="github-sponsors" class="section-subheading mt-24 mb-8 text-center">
      <a href="#github-sponsors">GitHub Sponsors</a>
    </h3>
    <div class="max-w-4xl mx-auto flex flex-wrap justify-center mb-8">
      <Sponsors size="large" align="center" />
    </div>

    <h3 id="github-contributors" class="section-subheading mt-24 mb-8 text-center">
      <a href="#github-contributors">GitHub Contributors</a>
    </h3>
    <div class="max-w-5xl mx-auto flex flex-wrap justify-center">
      {
        contributors.map((contributor) => (
          <a
            class="block w-12 h-12 relative overflow-hidden"
            title={contributor.login}
            href={contributor.html_url}
            target="_blank"
          >
            <Image
              src={contributor.avatar_url}
              alt={`${contributor.login} GitHub avatar`}
              width={100}
              height={100}
              class="block w-full h-full"
            />
          </a>
        ))
      }
    </div>
  </div>
</div>
