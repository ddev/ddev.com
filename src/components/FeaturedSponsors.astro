---
import featuredSponsors from "../featured-sponsors.json"

/**
 * Heights for logos that must render larger than the rest, keyed by the name
 * in `featured-sponsors.json`, for phones and from `sm` up. A logo that should
 * look smaller gets padding in its SVG `viewBox` instead, which the README
 * badges also respect.
 */
const nudges = {
  "Redfin Solutions": "h-11 w-11 sm:h-16 sm:w-16",
  MacStadium: "h-10 sm:h-15",
}

// Separate lead sponsors from regular sponsors
const leadSponsors = featuredSponsors.filter(sponsor => sponsor.isLeading === true)
const regularSponsors = featuredSponsors.filter(sponsor => sponsor.isLeading !== true)

// Add class property to relevant sponsor objects
regularSponsors.map((sponsor) => {
  if (sponsor.name in nudges) {
    sponsor.class = nudges[sponsor.name]
  }
})
---

<div class="relative flex flex-col items-center space-y-12">
  {/* Lead Sponsors Section */}
  {leadSponsors.length > 0 && (
      <div class="w-full flex justify-center pb-8 border-b border-gray-200 dark:border-white">
        {leadSponsors.map((sponsor) => (
            <a
                class="block relative overflow-hidden cursor-pointer h-11 mx-4 sm:h-16 sm:mx-6"
                title={sponsor.name}
                href={sponsor.url}
                target="_blank"
            >
              <img
                  src={sponsor.logo}
                  class="block w-auto h-full dark:hidden"
                  alt={`${sponsor.name} logo`}
              />
              <img
                  src={sponsor.darklogo}
                  class="hidden dark:block w-auto h-full"
                  alt={`${sponsor.name} logo`}
              />
            </a>
        ))}
      </div>
  )}

  {/* Regular Sponsors Section */}
  <div
      class="flex flex-wrap gap-y-8 sm:gap-y-12 justify-center items-center"
  >
    {regularSponsors.map((sponsor) => (
        <a
            class={
                `block relative overflow-hidden cursor-pointer mx-4 sm:mx-6 ` +
                (sponsor.class ?? `h-8 sm:h-12`)
            }
            title={sponsor.name}
            href={sponsor.url}
            target="_blank"
        >
          <img
              src={sponsor.logo}
              class="block w-auto h-full dark:hidden"
              alt={`${sponsor.name} logo`}
          />
          <img
              src={sponsor.darklogo}
              class="hidden dark:block w-auto h-full"
              alt={`${sponsor.name} logo`}
          />
        </a>
    ))}
  </div>
</div>