---
/**
 * Feature breakdown used on the homepage.
 */
import {
  CheckCircleIcon,
  Square3Stack3DIcon,
  GlobeAltIcon,
  KeyIcon,
  AdjustmentsVerticalIcon,
  BoltIcon,
  CloudArrowDownIcon,
  PuzzlePieceIcon,
  LockOpenIcon,
} from "@heroicons/react/24/solid/index.js"

const features = [
  {
    name: "Modern Development Stack",
    description:
      "PHP, Node.js, MariaDB, MySQL, PostgreSQL, nginx, Apache, Mailpit, Redis, and more.",
    icon: CheckCircleIcon,
  },
  {
    name: "Unlimited Projects",
    description:
      "Run multiple projects at once. Start and stop each as needed.",
    icon: Square3Stack3DIcon,
  },
  {
    name: "Multi-Platform",
    description:
      "Supported and rigorously tested on macOS, Windows, and Linux. Also runs in GitHub Codespaces.",
    icon: GlobeAltIcon,
  },
  {
    name: "Custom Domains & SSL",
    description:
      "Included router automatically handles custom domain names and HTTPS.",
    icon: KeyIcon,
  },
  {
    name: "App Ready",
    description:
      "Project types and quickstarts for Drupal, WordPress, Laravel, TYPO3, Craft CMS, Symfony, and over 25 more.",
    icon: AdjustmentsVerticalIcon,
  },
  {
    name: "Great Performance",
    description:
      "Mutagen file sync, on by default on macOS and Windows, keeps large codebases fast.",
    icon: BoltIcon,
  },
  {
    name: "Hosting Integrations",
    description:
      "Pull databases and files from Upsun, Pantheon, Acquia, Lagoon, and other hosts.",
    icon: CloudArrowDownIcon,
  },
  {
    name: "Extensible",
    description:
      "Painlessly use add-ons, run scripts in lifecycle hooks, and BYO Dockerfiles.",
    icon: PuzzlePieceIcon,
  },
  {
    name: "Open Source",
    description:
      "Apache 2.0 license; free to use, modify, and pass on to others.",
    icon: LockOpenIcon,
  },
]
---

<div class="relative section">
  <div
    class="site-container site-gutter text-center"
  >
    <h2 id="features" class="section-label"><a href="#features">Features</a></h2>
    <p class="section-title">
      Running in minutes, ready for the long haul.
    </p>
    <p class="section-lead">
      Start new DDEV projects in seconds. Customize, share, and extend with
      ease.
    </p>
    <div class="mt-12">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <div class="pt-6">
              <div class="rounded-lg px-6 pb-8">
                <div class="-mt-6">
                  <div>
                    <span class="icon inline-flex items-center justify-center rounded-md text-navy-300 p-3 dark:text-navy-100">
                      {() => {
                        return (
                          feature.icon && <feature.icon className="w-6 h-6" />
                        )
                      }}
                    </span>
                  </div>
                  <h3 class="text-lg font-medium tracking-tight text-gray-900 dark:text-white">
                    {feature.name}
                  </h3>
                  <p class="mt-5 text-base text-gray-500 dark:text-slate-400">
                    {feature.description}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
