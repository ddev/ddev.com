---
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import StructuredData from "../components/meta/StructuredData.astro"
import Icons from "../components/meta/Icons.astro"
import { SEO } from "astro-seo"
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  ORG_COUNTRY,
  ORG_CITY,
  ORG_STATE,
  ORG_POSTAL_CODE,
  ORG_STREET,
  ORG_NAME,
  ORG_EMAIL,
  ORG_FOUNDED,
  ORG_SAME_AS,
  ORG_PHONE,
} from "../const"
import themeToggleInitScript from "../scripts/theme-toggle-init.js?raw"
import { ogImageSize } from "../lib/images"

export interface Props {
  title: string
  description?: string
  noindex?: boolean
  nofollow?: boolean
  ogImage?: string
  ogImageAlt?: string
  link?: object[]
  structuredData?: object[]
  pubDate?: Date
  modifiedDate?: Date
}

const {
  title,
  description = SITE_DESCRIPTION,
  noindex = false,
  nofollow = false,
  ogImage,
  ogImageAlt,
  link = [],
  structuredData = [],
  pubDate,
  modifiedDate,
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString()
const pageTitle = title !== '' ? `${title} | DDEV` : 'DDEV'

let jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    ...structuredData,
    {
      "@type": "WebSite",
      description: SITE_DESCRIPTION,
      name: SITE_TITLE,
      publisher: {
        "@id": `${Astro.site}#identity`,
      },
      url: Astro.site,
    },
    {
      "@id": `${Astro.site}#identity`,
      "@type": "Organization",
      address: {
        "@type": "PostalAddress",
        addressCountry: ORG_COUNTRY,
        addressLocality: ORG_CITY,
        addressRegion: ORG_STATE,
        postalCode: ORG_POSTAL_CODE,
        streetAddress: ORG_STREET,
      },
      email: ORG_EMAIL,
      foundingDate: ORG_FOUNDED,
      image: `${Astro.site}img/og-default.png`,
      legalName: ORG_NAME,
      logo: {
        "@type": "ImageObject",
        height: 200,
        url: `${Astro.site}logos/ddev.png`,
        width: 852,
      },
      name: SITE_TITLE,
      sameAs: ORG_SAME_AS,
      telephone: ORG_PHONE,
      url: Astro.site,
    },
  ],
}

// Preview builds point og:image at their own deployment, so share checkers can
// load images that aren't on production yet. PREVIEW_URL is set for forks.
const ogImageBase =
  process.env.PREVIEW_URL ||
  (process.env.CF_PAGES_URL && process.env.CF_PAGES_BRANCH !== 'main'
    ? process.env.CF_PAGES_URL
    : Astro.site)

const ensureAbsoluteUrl = (url: string) => {
  if (url.startsWith('/')) {
    return new URL(url, ogImageBase).toString()
  }

  return url;
}

const ogImagePath = ogImage ? ogImage : `/img/og-default.png`
// Lets Facebook and LinkedIn show the image on the first share, before they
// have downloaded it
const ogImageDimensions = await ogImageSize(ogImagePath)

import "../styles/global.css"
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={pageTitle}
      description={description}
      canonical={canonicalUrl}
      noindex={noindex}
      nofollow={nofollow}
      charset={`utf-8`}
      openGraph={{
        basic: {
          title: title !== '' ? title : 'DDEV',
          url: canonicalUrl,
          type: `website`,
          image: ensureAbsoluteUrl(ogImagePath),
        },
        image: {
          alt: ogImageAlt ? ogImageAlt : `DDEV logo`,
          ...ogImageDimensions,
        },
        optional: {
          description: description,
          locale: `en_US`,
          siteName: SITE_TITLE,
        },
        article: pubDate ? {
          publishedTime: pubDate.toISOString(),
          modifiedTime: modifiedDate ? modifiedDate.toISOString() : undefined,
        } : undefined,
      }}
      twitter={{
        card: `summary_large_image`,
      }}
      extend={{
        link: link,
      }}
    />
    <Icons />
    <script is:inline set:html={themeToggleInitScript}></script>
    <StructuredData data={jsonLd} />
  </head>
  <body class="dark:bg-slate-800">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:font-bold focus:text-navy-300 focus:shadow-lg dark:focus:bg-slate-700 dark:focus:text-white"
      >Skip to content</a
    >
    <Header />
    <div id="content" tabindex="-1" class="mx-auto outline-none">
      <slot />
    </div>
    <Footer />
  </body>
</html>
